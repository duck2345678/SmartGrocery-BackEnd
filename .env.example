# =========================================================================
# SmartGrocery BackEnd Configuration Template (.env.example)
# Hướng dẫn: Sao chép tệp này thành '.env' và điền các giá trị thực tế của bạn.
# =========================================================================

# 1. Supabase / PostgreSQL Database Configuration
SUPABASE_DB_URL=jdbc:postgresql://your-supabase-db-host.supabase.com:6543/postgres?sslmode=require&ssl=true
SUPABASE_DB_USERNAME=postgres.your-project-id
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Security & JWT Token Configurations (JWT_SECRET_KEY phải là chuỗi ngẫu nhiên dài)
JWT_SECRET_KEY=your-random-jwt-secret-key-at-least-64-characters-long
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# 3. AI Capabilities Configuration (OpenRouter & DeepSeek Keys)
OPENROUTER_API_KEYS=your-openrouter-api-keys-comma-separated
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_PASS1_MODEL=google/gemini-2.0-flash-001
DEEPSEEK_API_KEY=your-deepseek-api-key-if-used

# 4. Spring Mail SMTP Configuration (Gửi mã OTP qua Email)
# Hướng dẫn tạo mật khẩu ứng dụng Gmail: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com

# 5. OTP Server Verification Key (Chuỗi ngẫu nhiên dài)
OTP_SERVER_SECRET=your-otp-server-secret-change-me
