# Supabase PostgreSQL Configuration
SUPABASE_DB_URL_DIRECT=jdbc:postgresql://your-host:5432/postgres
SUPABASE_DB_URL_POOLER=jdbc:postgresql://your-host:6543/postgres?pgbouncer=true&prepareThreshold=0
SUPABASE_DB_URL=jdbc:postgresql://your-host:5432/postgres
SUPABASE_DB_USERNAME=your-username
SUPABASE_DB_PASSWORD=your-password

HIBERNATE_DDL_AUTO=update
APP_SEEDING_ENABLED=true

# Gemini AI Configuration
GEMINI_API_KEY=your-api-key

# Firebase configuration (Base64 encoded JSON)
# Gợi ý tạo chuỗi base64:
# PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes((Get-Content .\firebase-service-account.json -Raw)))
FIREBASE_CREDENTIALS_BASE64=your-base64-credentials

# JWT Configuration
JWT_SECRET_KEY=your-secret-key
JWT_EXPIRATION=86400000
