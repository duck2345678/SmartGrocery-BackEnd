# Supabase PostgreSQL Configuration
SUPABASE_DB_URL=jdbc:postgresql://your-host:your-port/postgres?pgbouncer=true&prepareThreshold=0
SUPABASE_DB_USERNAME=your-username
SUPABASE_DB_PASSWORD=your-password

# Gemini AI Configuration
GEMINI_API_KEY=your-api-key

# Firebase configuration (Base64 encoded JSON)
FIREBASE_CREDENTIALS_BASE64=your-base64-credentials

# JWT Configuration
JWT_SECRET_KEY=your-secret-key
JWT_EXPIRATION=86400000
