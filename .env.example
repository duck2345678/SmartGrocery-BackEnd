# Supabase Configuration
SUPABASE_DB_URL=jdbc:postgresql://your-host:5432/postgres
SUPABASE_DB_USERNAME=your-username
SUPABASE_DB_PASSWORD=your-password
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Security & JWT Configuration
JWT_SECRET_KEY=your-secret-key
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# OpenRouter AI Configuration
OPENROUTER_API_KEYS=key1,key2,key3
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_PASS1_MODEL=google/gemini-2.0-flash-001

# Firebase configuration (Base64 encoded JSON)
FIREBASE_CREDENTIALS_BASE64=your-base64-credentials

# App Configuration
HIBERNATE_DDL_AUTO=validate
HIBERNATE_ALLOW_JDBC_METADATA_ACCESS=false
APP_SEEDING_ENABLED=true
AI_CHAT_PASS1_TIMEOUT_MS=12000
