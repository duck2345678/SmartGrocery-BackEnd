        o1_0.created_at,
        o1_0.customer_note,
        o1_0.delivered_at,
        o1_0.delivery_photo_url,
        o1_0.discount_amount,
        o1_0.internal_note,
        o1_0.lease_expires_at,
        o1_0.order_number,
        o1_0.packing_photo_url,
        o1_0.payment_method,
        o1_0.payment_status,
        o1_0.picked_at,
        o1_0.shipping_fee,
        o1_0.status,
        o1_0.subtotal,
        o1_0.tax_amount,
        o1_0.total_amount,
        o1_0.updated_at,
        o1_0.user_id 
